# Node 24.14+; run npm install, copy this file to .env, then npm run dev.
PORT=3001
APP_ORIGIN=http://localhost:5173
DATABASE_PATH=./data/lerabyte.sqlite
# This exact email becomes the admin only after successful email verification.
ADMIN_EMAIL=your-email@example.com
APPLICATIONS_OPEN=true

# For local development ONLY: prints sign-in codes to the server terminal.
# Production refuses this setting. Never expose a dev server publicly.
DEV_AUTH_CONSOLE=true

# Required for real email sign-in. No emails are sent until SMTP is configured.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
# Set SMTP_SECURE=true for port 465.
SMTP_SECURE=false
# Set to the exact number of trusted proxy hops for your host, otherwise 0.
TRUST_PROXY_HOPS=0
